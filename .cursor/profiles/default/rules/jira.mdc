### Issue Dashboard API
```typescript
// src/app/api/jira/dashboard/route.ts
export async function GET() {
  try {
    const [projects, recentIssues] = await Promise.all([
      JiraService.getProjects(),
      JiraService.searchIssues('updated >= -7d ORDER BY updated DESC', 10)
    ]);
    
    const dashboard = {
      projectCount: projects.length,
      recentIssues: recentIssues.issues.map((issue: any) => ({
        key: issue.key,
        summary: issue.fields.summary,
        status: issue.fields.status.name,
        updated: issue.fields.updated
      }))
    };
    
    return Response.json(dashboard);
    
  } catch (error) {
    console.error('Dashboard API error:', error.message);
    return Response.json({ 
      error: 'Failed to load dashboard data' 
    }, { status: 500 });
  }
}
```

### Issue Creation Form Handler
```typescript
// src/app/api/jira/issues/create/route.ts
export async function POST(request: Request) {
  try {
    const { projectKey, summary, description, issueType, assignee } = await request.json();
    
    // Validation
    if (!projectKey || !summary || !issueType) {
      return Response.json({ 
        error: 'Missing required fields: projectKey, summary, issueType' 
      }, { status: 400 });
    }
    
    const issue = await JiraService.createIssue({
      projectKey,
      summary,
      description,
      issueType,
      assignee
    });
    
    return Response.json({ 
      success: true, 
      issueKey: issue.key,
      issueUrl: `${(await getJiraConfig()).baseUrl}/browse/${issue.key}`
    });
    
  } catch (error) {
    console.error('Issue creation failed:', error.message);
    return Response.json({ 
      error: 'Failed to create issue' 
    }, { status: 500 });
  }
}
```


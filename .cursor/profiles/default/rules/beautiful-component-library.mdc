### **Status Badge (Always Use This)**
```tsx
interface StatusBadgeProps {
  status: 'active' | 'inactive' | 'pending' | 'error' | 'success';
  children: React.ReactNode;
}

export const StatusBadge = ({ status, children }: StatusBadgeProps) => {
  const statusStyles = {
    active: 'bg-gradient-to-r from-emerald-500 to-teal-500 text-white',
    inactive: 'bg-gradient-to-r from-slate-400 to-slate-500 text-white',
    pending: 'bg-gradient-to-r from-yellow-500 to-orange-500 text-white',
    error: 'bg-gradient-to-r from-red-500 to-red-600 text-white',
    success: 'bg-gradient-to-r from-emerald-500 to-green-500 text-white'
  };

  return (
    <Badge className={cn(
      "px-2 py-1 text-xs font-medium rounded-full shadow-sm",
      statusStyles[status]
    )}>
      {children}
    </Badge>
  );
};
```


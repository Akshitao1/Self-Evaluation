### **Enhanced Form Field (Always Use This)**
```tsx
interface FormFieldProps {
  label: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  error?: string;
  value?: string;
  onChange?: (e: React.ChangeEvent<HTMLInputElement>) => void;
}

export const FormField = ({ label, type = "text", placeholder, required, error, value, onChange }: FormFieldProps) => {
  return (
    <div className="space-y-2">
      <Label className="text-sm font-medium text-slate-700">
        {label} {required && <span className="text-red-500">*</span>}
      </Label>
      <Input
        type={type}
        placeholder={placeholder}
        required={required}
        value={value}
        onChange={onChange}
        className={cn(
          "border-slate-200 focus:border-blue-500 focus:ring-blue-500/20 transition-all duration-200 hover:border-slate-300",
          error && "border-red-300 focus:border-red-500 focus:ring-red-500/20"
        )}
      />
      {error && (
        <p className="text-sm text-red-600 animate-in slide-in-from-top-1 duration-200">
          {error}
        </p>
      )}
    </div>
  );
};
```

## 📊 DATA GRID COMPONENTS (ReUI)

### **Professional ReUI Data Grid (Always Use This)**
```tsx
"use client";

import { useMemo, useState } from "react";
import { createColumnHelper, getCoreRowModel, getFilteredRowModel, useReactTable } from "@tanstack/react-table";
import { DataGrid } from "@/components/ui/data-grid";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { EditIcon, TrashIcon, EyeIcon, UserIcon } from "lucide-react";

interface DataGridProps {
  title: string;
  data: any[];
  onRowClick?: (row: any) => void;
}

export const ProfessionalDataGrid = ({ title, data, onRowClick }: DataGridProps) => {
  const columnHelper = createColumnHelper<any>();

  const columns = useMemo(() => [
    columnHelper.display({
      id: "avatar",
      header: "",
      cell: ({ row }) => (
        <div className="h-10 w-10 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-full flex items-center justify-center shadow-lg">
          {row.original.avatar ? (
            <img src={row.original.avatar} alt="" className="w-full h-full rounded-full object-cover" />
          ) : (
            <UserIcon className="w-5 h-5 text-white" />
          )}
        </div>
      ),
      meta: { headerClassName: "w-16" }
    }),

    columnHelper.accessor("name", {
      header: "Name",
      cell: ({ row }) => (
        <div className="space-y-1">
          <p className="font-semibold text-slate-900">{row.original.name}</p>
          {row.original.email && (
            <p className="text-sm text-slate-600">{row.original.email}</p>
          )}
        </div>
      ),
      meta: { headerTitle: "User Information" }
    }),

    columnHelper.accessor("status", {
      header: "Status", 
      cell: ({ getValue }) => {
        const status = getValue();
        const statusConfig = {
          active: {
            gradient: "from-emerald-500 to-teal-500",
            label: "Active"
          },
          pending: {
            gradient: "from-orange-500 to-yellow-500", 
            label: "Pending"
          },
          inactive: {
            gradient: "from-slate-400 to-slate-500",
            label: "Inactive"
          }
        };
        
        const config = statusConfig[status] || statusConfig.inactive;
        
        return (
          <Badge className={`bg-gradient-to-r ${config.gradient} text-white shadow-sm hover:shadow-md transition-all duration-200`}>
            {config.label}
          </Badge>
        );
      },
      filterFn: "equals"
    }),

    columnHelper.accessor("role", {
      header: "Role",
      cell: ({ getValue }) => (
        <span className="text-slate-700 font-medium">{getValue()}</span>
      )
    }),

    columnHelper.display({
      id: "actions",
      header: "Actions",
      cell: ({ row }) => (
        <div className="flex items-center justify-center space-x-2">
          <Button 
            variant="ghost" 
            size="sm"
            className="hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 hover:scale-105"
            onClick={() => console.log("View", row.original)}
          >
            <EyeIcon className="w-4 h-4" />
          </Button>
          <Button 
            variant="ghost" 
            size="sm"
            className="hover:bg-emerald-50 hover:text-emerald-600 transition-all duration-200 hover:scale-105"
            onClick={() => console.log("Edit", row.original)}
          >
            <EditIcon className="w-4 h-4" />
          </Button>
          <Button 
            variant="ghost" 
            size="sm"
            className="hover:bg-red-50 hover:text-red-600 transition-all duration-200 hover:scale-105"
            onClick={() => console.log("Delete", row.original)}
          >
            <TrashIcon className="w-4 h-4" />
          </Button>
        </div>
      ),
      meta: { 
        headerClassName: "w-32 text-center",
        cellClassName: "text-center" 
      }
    })
  ], []);

  const table = useReactTable({
    data,
    columns,
    getCoreRowModel: getCoreRowModel(),
    getFilteredRowModel: getFilteredRowModel(),
  });

  return (
    <div className="space-y-4">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-xl font-bold bg-gradient-to-r from-slate-800 to-slate-600 bg-clip-text text-transparent">
            {title}
          </h2>
          <p className="text-slate-600 text-sm">Manage and view your data</p>
        </div>
        <Button className="bg-gradient-to-r from-blue-600 to-indigo-600 text-white hover:from-blue-700 hover:to-indigo-700 transition-all duration-200 shadow-lg hover:shadow-xl hover:scale-105">
          Add New
        </Button>
      </div>

      {/* Data Grid */}
      <div className="bg-white/95 backdrop-blur-sm rounded-xl border border-slate-200/50 shadow-lg overflow-hidden">
        <DataGrid
          table={table}
          recordCount={data.length}
          tableLayout={{
            headerBackground: true,
            headerBorder: true,
            rowBorder: true,
            stripped: true,
            headerSticky: true,
            columnsResizable: true,
            columnsPinnable: true,
            columnsVisibility: true
          }}
          tableClassNames={{
            base: "border-0",
            headerSticky: "sticky top-0 z-10 bg-gradient-to-r from-slate-50 to-blue-50 backdrop-blur-sm border-b border-slate-200/50",
            bodyRow: "hover:bg-blue-50/50 transition-colors duration-200 cursor-pointer"
          }}
          onRowClick={onRowClick}
          emptyMessage={
            <div className="flex flex-col items-center justify-center py-12">
              <div className="w-16 h-16 bg-gradient-to-br from-slate-100 to-slate-200 rounded-full flex items-center justify-center mb-4">
                <UserIcon className="w-8 h-8 text-slate-400" />
              </div>
              <p className="text-lg font-semibold text-slate-900 mb-2">No data available</p>
              <p className="text-slate-600 text-center max-w-sm">
                Get started by adding your first item to see it displayed here.
              </p>
            </div>
          }
        />
      </div>
    </div>
  );
};
```

### **Analytics Data Grid (Always Use This)**
```tsx
export const AnalyticsDataGrid = ({ title, metricsData }: { title: string; metricsData: any[] }) => {
  const columnHelper = createColumnHelper<any>();

  const columns = useMemo(() => [
    columnHelper.accessor("metric", {
      header: "Metric",
      cell: ({ row }) => (
        <div className="flex items-center space-x-3">
          <div className="h-10 w-10 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-lg flex items-center justify-center shadow-lg">
            <row.original.icon className="w-5 h-5 text-white" />
          </div>
          <div>
            <p className="font-semibold text-slate-900">{row.original.metric}</p>
            <p className="text-sm text-slate-600">{row.original.description}</p>
          </div>
        </div>
      )
    }),

    columnHelper.accessor("value", {
      header: "Current Value",
      cell: ({ getValue, row }) => (
        <div className="text-right">
          <p className="text-2xl font-bold text-slate-900">{getValue()}</p>
          <p className={`text-sm font-medium ${
            row.original.trend === 'up' 
              ? 'text-emerald-600' 
              : row.original.trend === 'down' 
                ? 'text-red-600' 
                : 'text-slate-600'
          }`}>
            {row.original.change}
          </p>
        </div>
      )
    }),

    columnHelper.accessor("trend", {
      header: "Trend",
      cell: ({ getValue }) => {
        const trend = getValue();
        const trendConfig = {
          up: {
            gradient: "from-emerald-500 to-teal-500",
            icon: "↗"
          },
          down: {
            gradient: "from-red-500 to-red-600", 
            icon: "↘"
          },
          stable: {
            gradient: "from-slate-400 to-slate-500",
            icon: "→"
          }
        };
        
        const config = trendConfig[trend] || trendConfig.stable;
        
        return (
          <div className="flex justify-center">
            <div className={`h-8 w-8 rounded-full bg-gradient-to-r ${config.gradient} flex items-center justify-center shadow-lg hover:scale-110 transition-transform duration-200`}>
              <span className="text-white font-bold text-sm">{config.icon}</span>
            </div>
          </div>
        );
      }
    })
  ], []);

  const table = useReactTable({
    data: metricsData,
    columns,
    getCoreRowModel: getCoreRowModel(),
  });

  return (
    <div className="bg-white/95 backdrop-blur-sm rounded-xl border border-slate-200/50 shadow-lg overflow-hidden">
      <DataGrid
        table={table}
        tableLayout={{
          headerBackground: true,
          cellBorder: true,
          rowRounded: false,
          stripped: false
        }}
        tableClassNames={{
          base: "border-0",
          header: "bg-gradient-to-r from-slate-50 to-blue-50",
          bodyRow: "hover:bg-blue-50/50 transition-all duration-200 hover:shadow-sm"
        }}
      />
    </div>
  );
};
```


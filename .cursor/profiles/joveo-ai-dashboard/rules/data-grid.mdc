// Professional table layout configuration
const tableLayout = {
  dense: false,                // Comfortable spacing
  cellBorder: true,           // Professional grid lines
  rowBorder: true,            // Clear row separation
  rowRounded: false,          // Clean rectangular rows
  stripped: true,             // Alternating row colors
  headerBackground: true,     // Gradient header background
  headerBorder: true,         // Header separation
  headerSticky: true,         // Sticky header on scroll
  columnsVisibility: true,    // Column show/hide controls
  columnsResizable: true,     // Resizable columns
  columnsPinnable: true,      // Pin important columns
  columnsMovable: true,       // Drag to reorder columns
};

// Professional styling classes

# Navigation Components

## Sidenav Components

### Global Navigation
```typescript
import { cn } from "@/lib/utils"
import { ChevronRight, MoreVertical } from "lucide-react"
import { Sheet, SheetContent, SheetTrigger } from "@/components/ui/sheet"

interface SidenavItemProps {
  icon?: React.ReactNode
  label: string
  isActive?: boolean
  hasSubmenu?: boolean
  onClick?: () => void
}

const SidenavItem = ({ icon, label, isActive, hasSubmenu, onClick }: SidenavItemProps) => (
  <button
    onClick={onClick}
    className={cn(
      "flex w-full items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-primary-lighter/50 transition-colors",
      isActive && "bg-primary-lighter text-primary font-medium"
    )}
  >
    {icon && <div className="w-6 h-6 flex items-center justify-center">{icon}</div>}
    <span className="flex-grow text-left">{label}</span>
    {hasSubmenu && <ChevronRight className="w-4 h-4 text-gray-400" />}
  </button>
)

interface SidenavGroupProps {
  title?: string
  children: React.ReactNode
}

const SidenavGroup = ({ title, children }: SidenavGroupProps) => (
  <div className="py-1">
    {title && (
      <div className="px-4 py-1 text-xs font-semibold text-gray-500 uppercase">
        {title}
      </div>
    )}
    {children}
  </div>
)

interface SidenavDividerProps {
  className?: string
}

const SidenavDivider = ({ className }: SidenavDividerProps) => (
  <div className={cn("h-px bg-gray-200 my-1", className)} />
)

// Main Sidenav Component
interface SidenavProps {
  isExpanded?: boolean
  onToggle?: () => void
}

const Sidenav = ({ isExpanded = true, onToggle }: SidenavProps) => {
  return (
    <div className={cn(
      "flex flex-col h-full bg-white border-r border-gray-200",
      isExpanded ? "w-64" : "w-16"
    )}>
      {/* Header */}
      <div className="flex items-center justify-between p-4 border-b border-gray-200">
        {isExpanded && <h2 className="text-sm font-medium">Navigation</h2>}
        <button
          onClick={onToggle}
          className="p-1 hover:bg-gray-100 rounded-md"
        >
          <MoreVertical className="w-5 h-5 text-gray-500" />
        </button>
      </div>

      {/* Navigation Items */}
      <div className="flex-1 overflow-y-auto">
        <SidenavGroup>
          <SidenavItem
            label="Feeds"
            isActive
          />
        </SidenavGroup>

        <SidenavDivider />

        <SidenavGroup title="Analytics">
          <SidenavItem
            icon={<AnalyticsIcon />}
            label="Mojo analytics"
            hasSubmenu
          />
          <SidenavItem
            icon={<AnalyticsIcon />}
            label="TAO analytics"
            hasSubmenu
          />
        </SidenavGroup>

        <SidenavDivider />

        <SidenavGroup title="Settings">
          <SidenavItem
            icon={<SettingsIcon />}
            label="Preferences"
          />
          <SidenavItem
            icon={<HelpIcon />}
            label="Help & Support"
          />
        </SidenavGroup>
      </div>

      {/* Footer */}
      <div className="p-4 border-t border-gray-200">
        <SidenavItem
          icon={<UserIcon />}
          label="Account"
          hasSubmenu
        />
      </div>
    </div>
  )
}

// Mobile Responsive Sidenav
const MobileSidenav = () => (
  <Sheet>
    <SheetTrigger asChild>
      <button className="p-2 text-gray-500 lg:hidden">
        <MenuIcon className="w-6 h-6" />
      </button>
    </SheetTrigger>
    <SheetContent side="left" className="p-0 w-80">
      <Sidenav />
    </SheetContent>
  </Sheet>
)
```

### Usage Guidelines
1. Use for main navigation and hierarchical menu structures
2. Implement collapsible/expandable functionality for space efficiency
3. Group related items logically with dividers and headers
4. Include visual indicators for active/selected states
5. Support both icon-only and expanded views
6. Ensure proper mobile responsiveness
7. Maintain consistent spacing and alignment

### Accessibility Considerations
- Use proper ARIA labels for navigation regions
- Implement keyboard navigation support
- Provide clear focus indicators
- Include screen reader descriptions
- Support reduced motion preferences
- Ensure proper color contrast

### Best Practices
1. Keep navigation hierarchy shallow (max 2-3 levels)
2. Use clear, descriptive labels
3. Include proper loading states
4. Handle long labels gracefully
5. Implement proper error states
6. Consider responsive breakpoints
7. Maintain consistent icon usage# Navigation Components


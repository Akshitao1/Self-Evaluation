# Joveo Footer Components

## Footer Components

### FooterLink Component
```typescript
import Link from "next/link";
import { cn } from "@/lib/utils";

interface FooterLinkProps {
  href: string;
  children: React.ReactNode;
  className?: string;
  external?: boolean;
}

const FooterLink = ({ href, children, className, external = false }: FooterLinkProps) => {
  if (external) {
    return (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        className={cn("text-sm text-[#3D4759] hover:text-[#303F9F] transition-colors", className)}
      >
        {children}
      </a>
    );
  }

  return (
    <Link 
      href={href}
      className={cn("text-sm text-[#3D4759] hover:text-[#303F9F] transition-colors", className)}
    >
      {children}
    </Link>
  );
}
```

### FooterColumn Component
```typescript
import { Typography } from "@/components/ui/typography";

interface FooterColumnProps {
  title: string;
  links: {
    label: string;
    href: string;
    external?: boolean;
  }[];
}

const FooterColumn = ({ title, links }: FooterColumnProps) => (
  <div className="space-y-4">
    <Typography variant="h6" className="text-[#3D4759] font-semibold">
      {title}
    </Typography>
    <div className="space-y-2">
      {links.map((link) => (
        <FooterLink key={link.href} href={link.href} external={link.external}>
          {link.label}
        </FooterLink>
      ))}
    </div>
  </div>
);
```

### Standard Footer Component (for Dashboard)
```typescript
import Link from "next/link";
import { Typography } from "@/components/ui/typography";
import { cn } from "@/lib/utils";
import { JoveoLogoIcon } from "@/components/JoveoLogoIcon";

interface FooterProps {
  className?: string;
}

export function Footer({ className }: FooterProps) {
  const currentYear = new Date().getFullYear();

  return (
    <footer className={cn("bg-white border-t border-gray-200 py-4 mt-auto", className)}>
      <div className="container mx-auto px-4">
        <div className="flex flex-col md:flex-row justify-between items-center space-y-2 md:space-y-0">
          <Typography variant="small" className="text-[#3D4759]">
            © {currentYear} Joveo. All rights reserved.
          </Typography>
          <div className="flex items-center space-x-6">
            <FooterLink href="/privacy">Privacy Policy</FooterLink>
            <FooterLink href="/terms">Terms of Service</FooterLink>
            <FooterLink href="/support">Support</FooterLink>
          </div>
        </div>
      </div>
    </footer>
  );
}
```


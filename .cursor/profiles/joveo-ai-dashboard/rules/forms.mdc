## Input Components

### Text Input
```typescript
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

<div className="space-y-2">
  <Label htmlFor="name" className="text-sm font-medium text-[#3D4759]">
    Name
  </Label>
  <Input 
    id="name"
    placeholder="Enter your name"
    className="border-[#E2E6F1] focus:border-[#303F9F] focus:ring-1 focus:ring-[#303F9F]"
  />
  {error && (
    <p className="text-xs text-[#E53935] mt-1">{error}</p>
  )}
</div>
```


      background: "#E4E8FF",
      color: "#303F9F"
    }
  }
}
```

### Main Content
```typescript
const MainContent = {
  padding: "40px",
  background: "#F4F5FB",
  maxWidth: "1440px",
  gridGap: "24px"
}
```


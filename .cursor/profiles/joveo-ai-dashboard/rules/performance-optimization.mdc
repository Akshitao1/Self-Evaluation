## Data Fetching & Caching

### Server Components
```typescript
// Good: Fetch data in Server Components
// app/dashboard/page.tsx
async function DashboardPage() {
  // This runs on the server and is cached according to fetch cache rules
  const data = await fetch('https://api.example.com/dashboard', {
    next: { revalidate: 60 } // Revalidate every 60 seconds
  });
  const dashboardData = await data.json();
  
  return <DashboardUI data={dashboardData} />;
}
```

### Client Data Fetching
```typescript
"use client";
import { useQuery } from '@tanstack/react-query';

// Good: Use React Query for client-side data
function MetricsPanel() {
  const { data, isLoading, error } = useQuery({
    queryKey: ['metrics'],
    queryFn: () => fetch('/api/metrics').then(res => res.json()),
    staleTime: 1000 * 60 * 5, // Consider data fresh for 5 minutes
    cacheTime: 1000 * 60 * 30, // Keep in cache for 30 minutes
  });
  
  if (isLoading) return <MetricsSkeletonLoader />;
  if (error) return <ErrorDisplay />;
  
  return <MetricsDisplay data={data} />;
}
```

## Virtual Rendering for Large Data Sets

### Table Virtualization
```typescript
"use client";
import { useVirtualizer } from '@tanstack/react-virtual';

function VirtualTable({ data }) {
  const parentRef = React.useRef();
  
  const rowVirtualizer = useVirtualizer({
    count: data.length,
    getScrollElement: () => parentRef.current,
    estimateSize: () => 35, // row height estimate
    overscan: 10, // extra rows to render above/below viewport
  });
  
  return (
    <div
      ref={parentRef}
      className="h-[500px] overflow-auto"
    >
      <div
        style={{
          height: `${rowVirtualizer.getTotalSize()}px`,
          position: 'relative',
        }}
      >
        {rowVirtualizer.getVirtualItems().map(virtualRow => (
          <div
            key={virtualRow.index}
            style={{
              position: 'absolute',
              top: 0,
              left: 0,
              width: '100%',
              height: `${virtualRow.size}px`,
              transform: `translateY(${virtualRow.start}px)`,
            }}
          >
            {data[virtualRow.index].name}
          </div>
        ))}
      </div>
    </div>
  );
}
```

### Windowed Lists
```typescript
"use client";
import { useWindowVirtualizer } from '@tanstack/react-virtual';

function VirtualizedMetricsList({ metrics }) {
  const parentRef = React.useRef();
  
  // Only render items in the viewport
  const virtualizer = useWindowVirtualizer({
    count: metrics.length,
    estimateSize: () => 150, // card height
    scrollMargin: parentRef.current?.offsetTop ?? 0,
  });
  
  return (
    <div ref={parentRef}>
      <div
        style={{
          height: virtualizer.getTotalSize(),
          position: 'relative',
        }}
      >
        {virtualizer.getVirtualItems().map(virtualItem => (
          <div
            key={virtualItem.key}
            style={{
              position: 'absolute',
              top: 0,
              left: 0,
              width: '100%',
              height: `${virtualItem.size}px`,
              transform: `translateY(${virtualItem.start}px)`,
            }}
          >
            <MetricCard data={metrics[virtualItem.index]} />
          </div>
        ))}
      </div>
    </div>
  );
}
```


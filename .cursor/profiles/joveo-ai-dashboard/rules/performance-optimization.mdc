# Joveo AI Dashboard Performance Optimization Rules

## Component Optimization Techniques

### Memoization

#### React.memo for Component Optimization
```typescript
// Good: Memoize components that render often but update infrequently
const MetricCard = React.memo(function MetricCard({ title, value, delta }: MetricCardProps) {
  return (
    <Card className="bg-white rounded-[4px] shadow-sm p-6">
      <div className="flex justify-between items-start mb-4">
        <Typography variant="label" className="text-[#3D4759]">{title}</Typography>
        <Typography variant="h1" className="text-[#1C2536]">{value}</Typography>
        {/* Delta indicator */}
      </div>
    </Card>
  );
});

// ALWAYS provide a custom comparison function for complex props
const TableRow = React.memo(
  function TableRow({ data, onSelect }: TableRowProps) {
    return (/* Row content */);
  },
  (prevProps, nextProps) => {
    // Custom comparison logic
    return prevProps.data.id === nextProps.data.id && 
           prevProps.data.version === nextProps.data.version;
  }
);
```

#### useMemo and useCallback
```typescript
// Good: Memoize expensive calculations
const sortedData = useMemo(() => {
  return data
    .filter(item => item.active)
    .sort((a, b) => a.value - b.value);
}, [data]);

// Good: Memoize callback functions passed as props
const handleRowClick = useCallback((id: string) => {
  setSelectedRow(id);
}, []);

// Bad: Don't memoize simple values
// ❌ Unnecessary memoization
const displayValue = useMemo(() => `$${value}`, [value]);

// ✅ Better approach
const displayValue = `$${value}`;
```

### Rendering Optimization

#### State Management
```typescript
// Good: Granular state updates
// Instead of a single large state object:
const [formData, setFormData] = useState({ 
  name: '',
  email: '',
  preferences: { /* many fields */ }
});

// Break into logical pieces to prevent unnecessary re-renders
const [name, setName] = useState('');
const [email, setEmail] = useState('');
const [preferences, setPreferences] = useState({ /* many fields */ });

// Good: Use functional updates for state that depends on previous state
const incrementCount = () => {
  setCount(prevCount => prevCount + 1);
};
```

#### Component Structure
```typescript

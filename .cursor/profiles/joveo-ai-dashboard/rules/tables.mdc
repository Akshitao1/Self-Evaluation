/>
```

## Styling and CSS Classes

### Required CSS Classes
```css
/* Table Container */
.joveo-table-container {
  @apply w-full bg-white rounded-[4px] border border-[#E2E6F1] overflow-hidden;
}

/* Table Header */
.joveo-table-header {
  @apply bg-[#F8F9FA] border-b border-[#E2E6F1];
}

/* Table Header Text */
.joveo-table-header th {
  @apply text-left align-middle font-medium text-[14px] text-[#3D4759] px-6 py-4;
}

/* Table Rows */
.joveo-table-row {
  @apply border-b border-[#E2E6F1] hover:bg-[#F8F9FA] transition-colors;
}

.joveo-table-row:hover {
  @apply bg-[#F0F4FF];
}

/* Table Cells */
.joveo-table-cell {
  @apply px-6 py-4 text-[14px] text-[#3D4759];
}

/* Search and Controls */
.joveo-table-search {
  @apply px-6 py-4 border-b border-[#E2E6F1];
}

/* Pagination */
.joveo-table-pagination {
  @apply px-6 py-4 border-t border-[#E2E6F1] bg-[#F8F9FA];
}
```

### Interactive Elements
```css
/* Sort Icons */
.joveo-sort-icon {
  @apply text-[#7681E8] opacity-50;
}

.joveo-sort-active {
  @apply text-[#303F9F] opacity-100;
}

/* Drag Handle */
.joveo-drag-handle {
  @apply cursor-move p-1 hover:bg-[#F0F4FF] rounded transition-colors;
}

/* Input Styling */
.joveo-input {
  @apply h-9 px-3 py-2 text-sm border border-[#E2E6F1] rounded-[4px] 
         focus:outline-none focus:ring-2 focus:ring-[#303F9F] focus:border-transparent
         placeholder:text-[#718096];
}

/* Button Styling */
.joveo-button-outline {
  @apply h-9 px-4 py-2 text-sm font-medium text-[#3D4759] 
         border border-[#E2E6F1] rounded-[4px] bg-white
         hover:bg-[#F0F4FF] hover:border-[#7681E8] transition-colors
         focus:outline-none focus:ring-2 focus:ring-[#303F9F] focus:border-transparent;
}
```

## Advanced Features

### Row Selection with Checkbox
```typescript
const columns: ColumnDef<YourDataType>[] = [
  {
    id: "select",
    header: ({ table }) => (
      <Checkbox
        checked={table.getIsAllRowsSelected()}
        onCheckedChange={table.getToggleAllRowsSelectedHandler()}
        className="h-4 w-4 rounded border-[#E2E6F1]"
      />
    ),
    cell: ({ row }) => (
      <Checkbox
        checked={row.getIsSelected()}
        onCheckedChange={row.getToggleSelectedHandler()}
        className="h-4 w-4 rounded border-[#E2E6F1]"
      />
    ),
    size: 40,
    enableSorting: false,
    enableResizing: false
  },
  // ... other columns
]
```

### Custom Cell Renderers
```typescript
// Date Formatter
const DateCell = ({ value }: { value: string }) => {
  const date = new Date(value)
  return (
    <div className="text-[14px] text-[#3D4759]">
      {date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      })}
    </div>
  )
}

// Usage in column definition
{
  id: "createdAt",
  header: "Created Date",
  accessorKey: "createdAt",
  cell: ({ row }) => <DateCell value={row.getValue("createdAt")} />,
  size: 140
}
```

### Row Click Handlers
```typescript
const handleRowClick = (row: Row<YourDataType>) => {
  const data = row.original
  // Navigate to detail page or open modal
  router.push(`/publishers/${data.id}`)
}

<DataTable
  columns={columns}
  data={data}
  onRowClick={handleRowClick}
  // ... other props
/>
```

## Performance Best Practices

### Memoized Components
```typescript
const MemoizedCell = React.memo(({ value, format }: { value: any, format: string }) => {
  const formattedValue = useMemo(() => {
    if (format === 'currency') {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD'
      }).format(value)
    }
    return value
  }, [value, format])
  
  return <span className="text-[14px] text-[#3D4759]">{formattedValue}</span>
})
```

### Efficient Column Definitions
```typescript
// Define columns outside component to prevent recreation
const columns: ColumnDef<YourDataType>[] = useMemo(() => [
  // ... column definitions
], [])

// Use stable references for data
const stableData = useMemo(() => data, [data])
```

## Accessibility Features

### ARIA Labels
```typescript
// Add aria-label to search input
<Input
  placeholder={searchPlaceholder}
  value={globalFilter ?? ""}
  onChange={(event) => setGlobalFilter(event.target.value)}
  className="joveo-input max-w-sm"
  aria-label="Search table data"
/>

// Add aria-label to sort buttons
<button
  onClick={header.column.getToggleSortingHandler()}
  aria-label={`Sort by ${header.column.columnDef.header}`}
  className="flex items-center gap-2"
>
  {/* ... */}
</button>
```

### Keyboard Navigation
```typescript
// Ensure table is keyboard navigable
<Table
  role="grid"
  aria-label="Data table"
  tabIndex={0}
>
  {/* ... */}
</Table>
```

## Required Implementation Checklist

1. ✅ **Column Definitions**: Properly typed with ColumnDef<T>
2. ✅ **DataTable Component**: Use the enhanced DataTable from ui/data-table.tsx
3. ✅ **Styling**: Apply Joveo design system classes
4. ✅ **Features**: Enable required features (search, sorting, pagination)
5. ✅ **Accessibility**: Include ARIA labels and keyboard support
6. ✅ **Performance**: Memoize components and data where appropriate
7. ✅ **Responsiveness**: Ensure mobile-friendly behavior
8. ✅ **Error Handling**: Graceful handling of empty states and errors

## Migration from Old Rules

- Replace custom table implementations with DataTable component
- Update column definitions to use ColumnDef<T> typing
- Apply Joveo CSS classes for consistent styling
- Remove outdated virtual scrolling and resizing implementations
- Use built-in features instead of custom solutions
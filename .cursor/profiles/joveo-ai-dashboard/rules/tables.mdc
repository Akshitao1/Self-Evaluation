```

### Status Column with Badge
```typescript
{
  id: "status",
  header: "Status",
  accessorKey: "status",
  cell: ({ row }) => {
    const status = row.getValue("status") as string
    const isActive = status === "Active"
    
    return (
      <div className={cn(
        "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
        isActive 

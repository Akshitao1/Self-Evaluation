## 🏗 IMPLEMENTATION PATTERNS

### 1. Service-Specific Config Functions
Create typed configuration getters in `src/lib/secrets/`:

```typescript
// src/lib/secrets/jira.ts
import { getRequiredSecret, getSecret } from '@/lib/secrets-manager';

export interface JiraConfig {
  apiToken: string;
  baseUrl: string;
  username: string;
  webhookSecret?: string;
}

export async function getJiraConfig(): Promise<JiraConfig> {
  return {
    apiToken: await getRequiredSecret('JIRA_API_TOKEN'),
    baseUrl: await getRequiredSecret('JIRA_BASE_URL'),
    username: await getRequiredSecret('JIRA_USERNAME'),
    webhookSecret: await getSecret('JIRA_WEBHOOK_SECRET'),
  };
}

// src/lib/secrets/snowflake.ts
// See snowflake.mdc for full implementation with connection manager

// App config (not in secrets)
const SNOWFLAKE_DATABASE = process.env.SNOWFLAKE_DATABASE || 'ANALYTICS_DB';
const SNOWFLAKE_SCHEMA = process.env.SNOWFLAKE_SCHEMA || 'PUBLIC';

export interface SnowflakeConfig {
  account: string;
  username: string;
  privateKey: string;
  authenticator: 'SNOWFLAKE_JWT';
  warehouse: string;
  database: string;
  schema: string;
  role: string;
  timeout: number;
}

export async function getSnowflakeConfig(): Promise<SnowflakeConfig> {
  const sshKey = await getRequiredSecret('SNOWFLAKE_SSH_KEY');
  if (!sshKey) throw new Error('SSH key required - no password auth');
  
  return {
    account: await getRequiredSecret('SNOWFLAKE_ACCOUNT'),
    username: await getRequiredSecret('SNOWFLAKE_USER'),
    privateKey: sshKey.replace(/\\n/g, '\n'), // Handle escaped newlines
    authenticator: 'SNOWFLAKE_JWT',
    warehouse: await getRequiredSecret('SNOWFLAKE_WAREHOUSE'),
    database: SNOWFLAKE_DATABASE,  // from app config
    schema: SNOWFLAKE_SCHEMA,      // from app config
    role: await getRequiredSecret('SNOWFLAKE_ROLE'),
    timeout: 60000,
  };
}

// src/lib/secrets/google.ts
export interface GoogleServiceAccountConfig {
  type: 'service_account';
  project_id: string;
  private_key_id?: string;
  private_key: string;
  client_email: string;
  client_id?: string;
  auth_uri: string;
  token_uri: string;
  auth_provider_x509_cert_url?: string;
  client_x509_cert_url?: string;
}

export async function getGoogleSheetsConfig(): Promise<GoogleServiceAccountConfig> {
  const privateKey = await getRequiredSecret('GOOGLE_PRIVATE_KEY');
  
  return {
    type: 'service_account',
    project_id: await getRequiredSecret('GOOGLE_PROJECT_ID'),
    client_email: await getRequiredSecret('GOOGLE_SERVICE_ACCOUNT_EMAIL'),
    private_key: privateKey.replace(/\\n/g, '\n'), // Handle escaped newlines
    auth_uri: 'https://accounts.google.com/o/oauth2/auth',
    token_uri: 'https://oauth2.googleapis.com/token',
    auth_provider_x509_cert_url: 'https://www.googleapis.com/oauth2/v1/certs',
  };
}

// src/lib/secrets/postgres.ts
export interface PostgresConfig {
  host: string;
  port: number;
  database: string;
  username: string;
  password: string;
}

export async function getPostgresConfig(): Promise<PostgresConfig> {
  return {
    host: await getSecret('POSTGRES_HOST') || 'localhost',
    port: parseInt(await getSecret('POSTGRES_PORT') || '5432'),
    database: await getRequiredSecret('POSTGRES_DATABASE'),
    username: await getRequiredSecret('POSTGRES_USERNAME'),
    password: await getRequiredSecret('POSTGRES_PASSWORD'),
  };
}
```

### 2. Connection Factory Pattern
Create reusable connection builders in `src/lib/connections/`:

```typescript
// src/lib/connections/jira.ts
import { getJiraConfig } from '@/lib/secrets/jira';

export async function createJiraClient() {
  const config = await getJiraConfig();
  
  // Example with a hypothetical Jira client
  return new JiraApi({
    protocol: 'https',
    host: config.baseUrl.replace(/^https?:\/\//, ''),
    username: config.username,
    password: config.apiToken,
    apiVersion: '2',
    strictSSL: true,
  });
}

// src/lib/connections/snowflake.ts
// See snowflake.mdc for full implementation with connection manager
import snowflake from 'snowflake-sdk';
import { getSnowflakeConfig } from '@/lib/secrets/snowflake';
import { connectionManager } from '@/lib/connections/connection-manager';

export async function createSnowflakeConnection() {
  const config = await getSnowflakeConfig();
  
  return new Promise((resolve, reject) => {
    const connection = snowflake.createConnection({
      account: config.account,
      username: config.username,
      privateKey: config.privateKey,
      warehouse: config.warehouse,
      database: config.database,
      schema: config.schema,
      role: config.role,
      authenticator: config.authenticator, // JWT authentication with private key
    });
    
    connection.connect((err, conn) => {
      if (err) {
        reject(new Error(`Snowflake connection failed: ${err.message}`));
      } else {
        resolve(conn);
      }
    });
  });
}

// IMPORTANT: Always use withServiceConnection() wrapper for proper cleanup
// See snowflake.mdc for ConnectionManager and SnowflakeService patterns

// src/lib/connections/google-sheets.ts
import { google } from 'googleapis';
import { getGoogleSheetsConfig } from '@/lib/secrets/google';

export async function createGoogleSheetsClient() {
  const credentials = await getGoogleSheetsConfig();
  
  const auth = new google.auth.GoogleAuth({
    credentials,
    scopes: ['https://www.googleapis.com/auth/spreadsheets'],
  });
  
  return google.sheets({ version: 'v4', auth });
}
```

### 3. Service Layer with Error Handling
Create business logic services in `src/lib/services/`:

```typescript
// src/lib/services/jira-service.ts
import { createJiraClient } from '@/lib/connections/jira';

export class JiraService {
  private static client: any = null;
  
  private static async getClient() {
    if (!this.client) {
      this.client = await createJiraClient();
    }
    return this.client;
  }
  
  static async getIssue(issueKey: string) {
    try {
      const client = await this.getClient();
      return await client.findIssue(issueKey);
    } catch (error) {
      console.error('Failed to fetch Jira issue:', error.message);
      throw new Error(`Jira service unavailable: ${error.message}`);
    }
  }
  
  static async createIssue(issueData: any) {
    try {
      const client = await this.getClient();
      return await client.addNewIssue(issueData);
    } catch (error) {
      console.error('Failed to create Jira issue:', error.message);
      throw new Error(`Failed to create issue: ${error.message}`);
    }
  }
}
```

## 🛡 MANDATORY SECURITY RULES

### ❌ NEVER DO THESE:
```typescript
// ❌ NEVER - Client-side secret access
'use client';
export function ClientComponent() {
  const [secret, setSecret] = useState();
  
  useEffect(() => {
    // This will fail and expose secrets to browser
    getRequiredSecret('API_KEY').then(setSecret);
  }, []);
}

// ❌ NEVER - Logging secret values
console.log('Database config:', await getPostgresConfig()); 

// ❌ NEVER - Returning secrets in API responses
export async function GET() {
  const secrets = await getAllSecrets();
  return Response.json(secrets); // Exposes all secrets!
}

// ❌ NEVER - Destructuring secrets in client components
export default function BadComponent({ apiKey }: { apiKey: string }) {
  // If apiKey comes from a secret, this is wrong
}
```

### ✅ ALWAYS DO THESE:
```typescript
// ✅ GOOD - Server-side API routes only
export async function GET() {
  try {
    const jiraConfig = await getJiraConfig();
    const client = await createJiraClient();
    const data = await client.getProjects();
    
    // Return processed data, never the config
    return Response.json({ projects: data });
  } catch (error) {
    // Log error message, not the config
    console.error('Jira API failed:', error.message);
    return Response.json({ error: 'Service unavailable' }, { status: 503 });
  }
}

// ✅ GOOD - Server components
export default async function ServerComponent() {
  const config = await getJiraConfig();
  const client = await createJiraClient();
  const projects = await client.getProjects();
  
  return (
    <div>
      <h1>Projects from {new URL(config.baseUrl).hostname}</h1>
      {projects.map(project => (
        <div key={project.id}>{project.name}</div>
      ))}
    </div>
  );
}

// ✅ GOOD - Safe logging with redaction
const config = await getJiraConfig();
console.log('Jira config loaded:', {
  baseUrl: config.baseUrl,
  username: config.username,
  apiToken: '[REDACTED]',
  webhookSecret: config.webhookSecret ? '[REDACTED]' : 'not set'
});
```


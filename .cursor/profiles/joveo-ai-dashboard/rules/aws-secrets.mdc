## 🚨 ERROR HANDLING PATTERNS

### Service Connection Wrapper:
```typescript
// src/lib/utils/service-wrapper.ts
export async function withServiceConnection<T>(
  serviceName: string,
  connectionFactory: () => Promise<any>,
  operation: (connection: any) => Promise<T>
): Promise<T> {
  let connection;
  
  try {
    console.log(`🔌 Connecting to ${serviceName}...`);
    connection = await connectionFactory();
    
    const result = await operation(connection);
    console.log(`✅ ${serviceName} operation completed`);
    return result;
    
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Unknown error';
    console.error(`❌ ${serviceName} operation failed:`, message);
    
    // Don't expose internal details to client
    throw new Error(`${serviceName} service is currently unavailable`);
    
  } finally {
    // Clean up connection resources
    if (connection?.close) {
      try {
        await connection.close();
        console.log(`🔌 ${serviceName} connection closed`);
      } catch (closeError) {
        console.warn(`⚠️ Failed to close ${serviceName} connection:`, closeError);
      }
    }
  }
}

// Usage example:
export async function getJiraProjects() {
  return withServiceConnection(
    'Jira',
    () => createJiraClient(),
    async (client) => await client.getProjects()
  );
}
```

### Startup Validation:
```typescript
// src/lib/validation/secrets-validation.ts
export async function validateRequiredSecrets() {
  const requiredSecrets = [
    // Core application secrets
    'POSTGRES_DATABASE',
    'POSTGRES_USERNAME', 
    'POSTGRES_PASSWORD',
    
    // Optional service secrets (validate only if service is enabled)
    ...(process.env.ENABLE_JIRA === 'true' ? [
      'JIRA_API_TOKEN',
      'JIRA_BASE_URL',
      'JIRA_USERNAME'
    ] : []),
    
         ...(process.env.ENABLE_SNOWFLAKE === 'true' ? [
       'SNOWFLAKE_ACCOUNT',
       'SNOWFLAKE_USER',
       'SNOWFLAKE_SSH_KEY'
     ] : []),
  ];
  
  const missing: string[] = [];
  
  for (const secretKey of requiredSecrets) {
    try {
      await getRequiredSecret(secretKey);
    } catch (error) {
      missing.push(secretKey);
    }
  }
  
  if (missing.length > 0) {
    throw new Error(
      `Missing required secrets in AWS Secrets Manager: ${missing.join(', ')}\n` +
      `Please ensure these secrets are configured in: ${process.env.SECRET_NAME}`
    );
  }
  
  console.log(`✅ All ${requiredSecrets.length} required secrets validated`);
}
```

## 🔍 DEBUGGING UTILITIES

### Safe Debug Functions:
```typescript
// src/lib/debug/secrets-debug.ts
export async function debugSecretsStatus() {
  // Only allow in development
  if (process.env.NODE_ENV === 'production') {
    throw new Error('🚫 Debug functions disabled in production');
  }
  
  const { secretsManager } = await import('@/lib/secrets-manager');
  const cacheInfo = secretsManager.getCacheInfo();
  const secretKeys = await secretsManager.getSecretKeys();
  
  console.log('\n🔐 === SECRETS DEBUG INFO ===');
  console.log(`📊 Cache Status: ${cacheInfo.isValid ? '✅ Valid' : '❌ Invalid'}`);
  console.log(`⏰ Cache Age: ${Math.round(cacheInfo.age / 1000)}s`);
  console.log(`🔢 Total Secrets: ${cacheInfo.keyCount}`);
  console.log(`🔑 Secret Keys:`);
  
  secretKeys.forEach(key => {
    const isSensitive = /(?:PASSWORD|TOKEN|KEY|SECRET)/i.test(key);
    console.log(`   ${isSensitive ? '🔒' : '📝'} ${key}: ${isSensitive ? '[REDACTED]' : '✓'}`);
  });
  
  console.log('🔐 ========================\n');
}

// API route for development debugging
// src/app/api/debug/secrets/route.ts
export async function GET() {
  if (process.env.NODE_ENV === 'production') {
    return Response.json({ error: 'Not available in production' }, { status: 403 });
  }
  
  try {
    const { secretsManager } = await import('@/lib/secrets-manager');
    const cacheInfo = secretsManager.getCacheInfo();
    const secretKeys = await secretsManager.getSecretKeys();
    
    return Response.json({
      cache: cacheInfo,
      secretCount: secretKeys.length,
             availableServices: {
         jira: secretKeys.includes('JIRA_API_TOKEN'),
         snowflake: secretKeys.includes('SNOWFLAKE_ACCOUNT') && secretKeys.includes('SNOWFLAKE_SSH_KEY'),
         googleSheets: secretKeys.includes('GOOGLE_SERVICE_ACCOUNT_EMAIL'),
         postgres: secretKeys.includes('POSTGRES_DATABASE'),
       }
    });
  } catch (error) {
    return Response.json({ 
      error: 'Failed to load secrets info',
      message: error instanceof Error ? error.message : 'Unknown error'
    }, { status: 500 });
  }
}
```


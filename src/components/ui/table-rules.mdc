## ⚡ PERFORMANCE OPTIMIZATIONS

### **Column Memoization**
```typescript
// Always memoize column definitions
const columns = React.useMemo(() => [
  // ... column definitions
], []) // Empty dependency array for static columns
```

### **Data Memoization**
```typescript
// Memoize processed data
const processedData = React.useMemo(() => {
  return data.map(item => ({
    ...item,
    calculatedField: calculateSomething(item)
  }))
}, [data])
```

### **Row Click Handlers**
```typescript
// Use useCallback for row click handlers
const handleRowClick = React.useCallback((row: Row<YourDataType>) => {
  // Handle row click
}, [])
```

## 🔧 CONFIGURATION OPTIONS

### **DataTable Props**
```typescript
interface DataTableProps<TData, TValue> {
  // Core data
  columns: ColumnDef<TData, TValue>[]
  data: TData[]
  
  // Features
  enableSearch?: boolean                    // Global search
  enableColumnVisibility?: boolean         // Show/hide columns
  enableColumnReordering?: boolean         // Drag to reorder
  enableColumnResizing?: boolean           // Resize columns
  enablePagination?: boolean               // Pagination controls
  
  // Customization
  searchPlaceholder?: string               // Search input placeholder
  pageSize?: number                        // Initial page size
  className?: string                       // Additional CSS classes
  
  // Interactions
  onRowClick?: (row: Row<TData>) => void  // Row click handler
  
  // Special features
  showTotalRow?: boolean                   // Show total row
  totalRowData?: Partial<TData>           // Total row data
}
```

### **Column Configuration**
```typescript
interface ColumnConfig {
  size?: number                    // Initial column width
  minSize?: number                 // Minimum column width
  maxSize?: number                 // Maximum column width
  enableSorting?: boolean          // Allow sorting
  enableResizing?: boolean         // Allow resizing
  enablePinning?: boolean          // Allow pinning (future)
  enableHiding?: boolean           // Allow hiding
}
```

## 🚫 FORBIDDEN PRACTICES

### **Never Do This**
```typescript
// ❌ Don't create columns inside render
const columns = [
  // This will recreate columns on every render
]

// ❌ Don't inline complex cell renderers
cell: ({ getValue }) => (
  <div className="complex-inline-jsx">
    {/* Complex JSX here */}
  </div>
)

// ❌ Don't forget to memoize
const columns = [/* ... */] // Missing useMemo

// ❌ Don't use basic HTML tables
<table> {/* Use DataTable instead */}
```

### **Always Do This**
```typescript
// ✅ Memoize column definitions
const columns = React.useMemo(() => [/* ... */], [])

// ✅ Use proper TypeScript interfaces
interface YourDataType {
  id: string
  name: string
}

// ✅ Handle loading and error states
{isLoading ? <Skeleton /> : <DataTable {...props} />}

// ✅ Use consistent styling classes
className="bg-white rounded-lg border shadow-sm"
```

## 📱 RESPONSIVE DESIGN

### **Mobile Considerations**
```typescript
// Responsive column visibility
const columns = React.useMemo(() => [
  columnHelper.accessor("name", {
    header: "Name",
    cell: ({ getValue }) => <span>{getValue()}</span>,
    size: 200,
    enableHiding: true, // Allow hiding on mobile
  }),
  // Less important columns can be hidden on mobile
  columnHelper.accessor("details", {
    header: "Details",
    cell: ({ getValue }) => <span>{getValue()}</span>,
    size: 150,
    enableHiding: true,
  }),
], [])
```

### **Touch Interactions**
```typescript
// Ensure touch-friendly interactions
const sensors = useSensors(
  useSensor(PointerSensor, {
    activationConstraint: {
      distance: 8, // Minimum drag distance
    },
  }),
  useSensor(KeyboardSensor, {
    coordinateGetter: sortableKeyboardCoordinates,
  })
)
```

## 🔍 ACCESSIBILITY

### **ARIA Labels**
```typescript
// Proper ARIA labels for interactive elements
<Button
  aria-label="Sort by name"
  onClick={() => column.toggleSorting()}
>
  Name
</Button>

// Screen reader support for sortable columns
<div
  role="button"
  tabIndex={0}
  aria-label={`Sort by ${column.id}`}
  onKeyDown={(e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      column.toggleSorting()
    }
  }}
>
  {column.header}
</div>
```

### **Keyboard Navigation**
```typescript
// Support keyboard navigation
const handleKeyDown = (e: React.KeyboardEvent, action: () => void) => {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault()
    action()
  }
}
```


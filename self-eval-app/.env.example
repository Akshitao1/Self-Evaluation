# ── Google Sheets store (required on Vercel; without it, falls back to a local file) ──
# Full service-account JSON, single line. Share the target sheet with the SA email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", "...": "..."}
# The spreadsheet id from its URL: docs.google.com/spreadsheets/d/<THIS>/edit
SELF_EVAL_SHEET_ID=

# ── Scheduled sync auth (optional) ──
CRON_SECRET=

# ── Live Slack (optional; otherwise use the monthly /self-eval-sync command to POST candidates) ──
# SLACK_BOT_TOKEN=xoxb-...
# SELF_EVAL_SLACK_CHANNELS=margin,cs-team,product,bidding
# SELF_EVAL_PERSON=Akshita
# ANTHROPIC_API_KEY=
# SELF_EVAL_MODEL=claude-sonnet-5

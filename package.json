{
  "name": "ai-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run clean",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next node_modules/.cache .turbo",
    "fresh": "npm run clean && npm install && npm run dev",
    "profile:default": "cp .cursor/profiles/default/.cursorrules .cursorrules && node scripts/apply-profile.js default && echo '✅ Switched to DEFAULT profile - Rapid development with context-aware UI'",
    "profile:joveo": "cp .cursor/profiles/joveo-ai-dashboard/.cursorrules .cursorrules && node scripts/apply-profile.js joveo && echo '✅ Switched to JOVEO-AI-DASHBOARD profile - Locked Joveo design standards'",
    "profile:status": "head -3 .cursorrules | grep 'ACTIVE PROFILE' || echo '❓ No active profile detected'",
    "profile:validate": "NODE_ENV=development .cursor/validate-profile.sh",
    "predev": "npm run profile:validate",
    "deploy": "bash ./deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.845.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/recharts": "^1.8.29",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "google-auth-library": "^10.1.0",
    "googleapis": "^152.0.0",
    "lucide-react": "^0.525.0",
    "next": "15.3.6",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "prisma": "^6.11.1",
    "radix-ui": "^1.4.2",
    "react": "19.2.1",
    "react-day-picker": "^9.14.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.62.0",
    "react-resizable": "^3.0.5",
    "recharts": "^3.1.0",
    "snowflake-sdk": "^2.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
